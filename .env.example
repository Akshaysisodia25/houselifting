# ==============================================================================
# TDBD Engineering Works — Environment Configuration Template
# ==============================================================================
# Configure these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit your real .env or secrets to Git.

# 1. Production PostgreSQL Database Connection URL (Supabase, Neon, AWS RDS, etc.)
# If using a cloud database, paste its connection pooling/direct URL here.
DATABASE_URL="postgresql://user:password@cloud-db-host:5432/dbname?sslmode=require"

# 2. Authentication Secret (32+ random characters for JWT signing)
JWT_SECRET="generate-a-secure-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# 3. Google OAuth 2.0 / OpenID Connect Configuration (PKCE)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Set to exact production callback URL in Vercel, or leave blank to auto-resolve from request host
GOOGLE_REDIRECT_URI="https://houselifting.vercel.app/api/auth/google/callback"

# 4. Server-Side Allowlist of Authorized Administrator Google Emails (comma-separated)
ADMIN_GOOGLE_EMAILS="admin1@example.com,admin2@example.com,admin3@example.com"

# 5. Production Domain / Allowed CORS Origin
CLIENT_URL="https://houselifting.vercel.app"
NODE_ENV="production"

# 6. Cloudflare Turnstile CAPTCHA (Bot Protection for Enquiries)
# Frontend Public Site Key (Default uses Cloudflare's always-passing test key)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Backend Private Secret Key (Default uses Cloudflare's always-passing test secret)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_API_BASE_URL="/api"

